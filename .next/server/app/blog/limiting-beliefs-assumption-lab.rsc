e-domains","className":"font-body text-sm text-grey-DEFAULT hover:text-orange-DEFAULT transition-colors flex items-baseline gap-2","children":[["$","span",null,{"className":"font-mono text-[0.5rem] text-orange-DEFAULT/80","children":["03","."]}],["$","span",null,{"children":"The Five Core Domains"}]]}]}],["$","li","the-replacement-process",{"children":["$","a",null,{"href":"#the-replacement-process","className":"font-body text-sm text-grey-DEFAULT hover:text-orange-DEFAULT transition-colors flex items-baseline gap-2","children":[["$","span",null,{"className":"font-mono text-[0.5rem] text-orange-DEFAULT/80","children":["04","."]}],["$","span",null,{"children":"The Replacement Process"}]]}]}],["$","li","the-timeline",{"children":["$","a",null,{"href":"#the-timeline","className":"font-body text-sm text-grey-DEFAULT hover:text-orange-DEFAULT transition-colors flex items-baseline gap-2","children":[["$","span",null,{"className":"font-mono text-[0.5rem] text-orange-DEFAULT/80","children":["05","."]}],["$","span",null,{"children":"The Timeline"}]]}]}],["$","li","the-assumption-lab",{"children":["$","a",null,{"href":"#the-assumption-lab","className":"font-body text-sm text-grey-DEFAULT hover:text-orange-DEFAULT transition-colors flex items-baseline gap-2","children":[["$","span",null,{"className":"font-mono text-[0.5rem] text-orange-DEFAULT/80","children":["06","."]}],["$","span",null,{"children":"The Assumption Lab"}]]}]}]]}]]}],[["$","h2","0",{"id":"what-a-limiting-belief-actually-is","className":"scroll-mt-24 font-display text-2xl md:text-3xl tracking-[0.03em] text-white mt-12 mb-4","children":"What a Limiting Belief Actually Is"}],["$","p","1",{"className":"font-body text-grey-DEFAULT leading-relaxed mb-5 text-[1.05rem]","children":["A limiting belief is not a truth about reality. It is an assumption — formed early, repeated often, emotionally charged enough that the subconscious treats it as fact."]}],["$","p","2",{"className":"font-body text-grey-DEFAULT leading-relaxed mb-5 text-[1.05rem]","children":["\"Money is hard to come by.\" \"I'm not the kind of person who gets that.\" \"Good relationships don't last.\" \"Success like that isn't for people like me.\""]}],["$","p","3",{"className":"font-body text-grey-DEFAULT leading-relaxed mb-5 text-[1.05rem]","children":["These are not observations. They are programs — installed through experience and repetition, now running silently in the background of every decision, every reaction, every interpretation of events."]}],["$","p","4",{"className":"font-body text-grey-DEFAULT leading-relaxed mb-5 text-[1.05rem]","children":["And here is the key insight: ",["$","strong","1",{"className":"text-white font-semibold","children":"these programs can be replaced."}]," They are not carved into you. They are instructions to the subconscious, and the subconscious accepts new instructions when they are delivered correctly."]}],["$","h2","5",{"id":"the-identification-process","className":"scroll-mt-24 font-display text-2xl md:text-3xl tracking-[0.03em] text-white mt-12 mb-4","children":"The Identification Process"}],["$","p","6",{"className":"font-body text-grey-DEFAULT leading-relaxed mb-5 text-[1.05rem]","children":["Most limiting beliefs operate below conscious awareness. You don't ",["$","em","1",{"className":"text-white/90 italic","children":"think"}]," \"I don't deserve love.\" You just find yourself self-sabotaging in relationships without knowing why."]}],["$","p","7",{"className":"font-body text-grey-DEFAULT leading-relaxed mb-5 text-[1.05rem]","children":["To surface them, use what we call the Assumption Lab — a series of scenario-based questions that reveal your ",["$","em","1",{"className":"text-white/90 italic","children":"default"}]," response to common triggering situations:"]}],["$","ul","8",{"className":"flex flex-col gap-3 my-6","children":[["$","li","0",{"className":"flex items-start gap-3 font-body text-grey-DEFAULT","children":[["$","span",null,{"className":"text-orange-DEFAULT mt-1 flex-shrink-0","children":"✦"}],["$","span",null,{"children":["When something goes wrong, what does your inner voice say first?"]}]]}],["$","li","1",{"className":"flex items-start gap-3 font-body text-grey-DEFAULT","children":[["$","span",null,{"className":"text-orange-DEFAULT mt-1 flex-shrink-0","children":"✦"}],["$","span",null,{"children":["When someone else succeeds in an area where you want to succeed, what do you feel?"]}]]}],["$","li","2",{"className":"flex items-start gap-3 font-body text-grey-DEFAULT","children":[["$","span",null,{"className":"text-orange-DEFAULT mt-1 flex-shrink-0","children":"✦"}],["$","span",null,{"children":["When you imagine having what you most desire, what objection immediately arises?"]}]]}]]}],["$","p","9",{"className":"font-body text-grey-DEFAULT leading-relaxed mb-5 text-[1.05rem]","children":["The objection is the belief. The first internal reaction is the program."]}],["$","h2","10",{"id":"the-five-core-domains","className":"scroll-mt-24 font-display text-2xl md:text-3xl tracking-[0.03em] text-white mt-12 mb-4","children":"The Five Core Domains"}],["$","p","11",{"className":"font-body text-grey-DEFAULT leading-relaxed mb-5 text-[1.05rem]","children":["Limiting beliefs tend to cluster in five areas:"]}],["$","p","12",{"className":"font-body text-grey-DEFAULT leading-relaxed mb-5 text-[1.05rem]","children":["",["$","strong","1",{"className":"text-white font-semibold","children":"Money:"}]," Scarcity vs. abundance consciousness. Do you assume money flows to you naturally, or that it requires struggle?"]}],["$","p","13",{"className":"font-body text-grey-DEFAULT leading-relaxed mb-5 text-[1.05rem]","children":["",["$","strong","1",{"className":"text-white font-semibold","children":"Love:"}]," Worthiness and trust. Do you assume you are inherently lovable, or that love must be earned and can be lost at any moment?"]}],["$","p","14",{"className":"font-body text-grey-DEFAULT leading-relaxed mb-5 text-[1.05rem]","children":["",["$","strong","1",{"className":"text-white font-semibold","children":"Self-Worth:"}]," Identity. At the deepest level, who do you believe you are? The answer to this shapes everything else."]}],["$","p","15",{"className":"font-body text-grey-DEFAULT leading-relaxed mb-5 text-[1.05rem]","children":["",["$","strong","1",{"className":"text-white font-semibold","children":"Health:"}]," Vitality vs. decline. Do you assume your body is capable of healing and thriving?"]}],["$","p","16",{"className":"font-body text-grey-DEFAULT leading-relaxed mb-5 text-[1.05rem]","children":["",["$","strong","1",{"className":"text-white font-semibold","children":"Purpose:"}]," Significance. Do you assume your presence matters — that your desires are valid and your impact real?"]}],["$","h2","17",{"id":"the-replacement-process","className":"scroll-mt-24 font-display text-2xl md:text-3xl tracking-[0.03em] text-white mt-12 mb-4","children":"The Replacement Process"}],["$","p","18",{"className":"font-body text-grey-DEFAULT leading-relaxed mb-5 text-[1.05rem]","children":["Once you've identified a limiting belief, the process is straightforward — though not easy."]}],["$","p","19",{"className":"font-body text-grey-DEFAULT leading-relaxed mb-5 text-[1.05rem]","children":["",["$","strong","1",{"className":"text-white font-semibold","children":"Step 1: Name it without judgment."}],"\n\"I have a program that says money is scarce for me.\" Not \"I am broken\" — \"I have a program.\""]}],["$","p","20",{"className":"font-body text-grey-DEFAULT leading-relaxed mb-5 text-[1.05rem]","children":["",["$","strong","1",{"className":"text-white font-semibold","children":"Step 2: Find the counter-assumption."}],"\nWhat would a person without this belief assume? \"Money flows to me naturally and consistently.\" Make it specific and first-person."]}],["$","p","21",{"className":"font-body text-grey-DEFAULT leading-relaxed mb-5 text-[1.05rem]","children":["",["$","strong","1",{"className":"text-white font-semibold","children":"Step 3: Deliver it in SATS."}],"\nCreate a brief scene that implies this new assumption is your reality. Enter SATS nightly with this scene for 30+ days."]}],["$","p","22",{"className":"font-body text-grey-DEFAULT leading-relaxed mb-5 text-[1.05rem]","children":["",["$","strong","1",{"className":"text-white font-semibold","children":"Step 4: Use Revision when the old belief triggers."}],"\nWhen the old program fires during the day, use the Revision Journal that evening to neutralize the reaction before it can be reinforced."]}],["$","p","23",{"className":"font-body text-grey-DEFAULT leading-relaxed mb-5 text-[1.05rem]","children":["",["$","strong","1",{"className":"text-white font-semibold","children":"Step 5: Watch for and follow the bridge."}],"\nAs the new assumption takes hold, opportunities and evidence will begin to appear. Take them."]}],["$","h2","24",{"id":"the-timeline","className":"scroll-mt-24 font-display text-2xl md:text-3xl tracking-[0.03em] text-white mt-12 mb-4","children":"The Timeline"}],["$","p","25",{"className":"font-body text-grey-DEFAULT leading-relaxed mb-5 text-[1.05rem]","children":["Replacing a deeply embedded limiting belief — one that's been running for 20+ years — doesn't happen overnight. But with consistent SATS practice and daily revision, noticeable shifts typically occur within 30-90 days."]}],["$","p","26",{"className":"font-body text-grey-DEFAULT leading-relaxed mb-5 text-[1.05rem]","children":["The first sign is rarely external. It's internal: the old thought arrives, and for the first time, you don't believe it. You notice it as a thought rather than a truth."]}],["$","p","27",{"className":"font-body text-grey-DEFAULT leading-relaxed mb-5 text-[1.05rem]","children":["That gap — between thought and belief — is where your freedom lives."]}],["$","h2","28",{"id":"the-assumption-lab","className":"scroll-mt-24 font-display text-2xl md:text-3xl tracking-[0.03em] text-white mt-12 mb-4","children":"The Assumption Lab"}],["