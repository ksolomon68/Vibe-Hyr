0:["A6jreOC79KKPZRtx9TnSh",[[["",{"children":["blog",{"children":[["slug","how-to-do-sats-step-by-step","d"],{"children":["__PAGE__?{\"slug\":\"how-to-do-sats-step-by-step\"}",{}]}]}]},"$undefined","$undefined",true],["",{"children":["blog",{"children":[["slug","how-to-do-sats-step-by-step","d"],{"children":["__PAGE__",{},[["$L1",[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Article\",\"headline\":\"How to Do SATS Step-by-Step: The 10-Minute Nightly Protocol\",\"description\":\"Follow this 5-step beginner's guide to doing SATS (State Akin to Sleep) tonight, including scene construction, reaching the hypnagogic state, and troubleshooting.\",\"datePublished\":\"2025-03-10\",\"dateModified\":\"2026-11-20\",\"articleSection\":\"Guides\",\"keywords\":\"how to do SATS step by step, SATS tutorial for beginners, falling asleep in SATS, what if I can't visualize in SATS, hypnagogic state guide, 10 minute nightly manifestation routine\",\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://vibehyr.com/blog/how-to-do-sats-step-by-step\"},\"author\":{\"@type\":\"Person\",\"name\":\"Keisha Solomon\",\"jobTitle\":\"Founder & Master Architect, Vibe Hyr\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"Vibe Hyr\",\"url\":\"https://vibehyr.com\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://vibehyr.com/icons/icon-512.png\"}},\"image\":\"https://vibehyr.com/images/og-image.png\"}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://vibehyr.com\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Blog\",\"item\":\"https://vibehyr.com/blog\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"How to Do SATS: A Complete Step-by-Step Guide for Beginners\",\"item\":\"https://vibehyr.com/blog/how-to-do-sats-step-by-step\"}]}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"What if I fall asleep too fast during SATS?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"If you fall asleep before locking in your scene, prop yourself at a slight 45-degree angle with two pillows or practice a 10-minute session right after lunch when your circadian rhythm naturally dips into alpha and theta.\"}},{\"@type\":\"Question\",\"name\":\"Can I do SATS if I have aphantasia or cannot visualize clearly?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. Visual imagery is only one delivery channel. You can anchor your SATS scene through spatial audio (hearing a loved one or colleague congratulate you), tactile sensation (feeling a desk, steering wheel, or ring), and the somatic feeling of relief.\"}}]}"}}],["$","$L2",null,{}],["$","main",null,{"className":"pt-[68px] min-h-screen","children":[["$","section",null,{"className":"py-14 px-6 md:px-14 border-b border-white/8 relative","children":[["$","div",null,{"className":"absolute left-0 top-0 bottom-0 w-1 bg-orange-DEFAULT"}],["$","div",null,{"className":"max-w-3xl mx-auto pl-4","children":[["$","nav",null,{"aria-label":"Breadcrumb","className":"mb-8","children":["$","ol",null,{"className":"flex items-center gap-2 font-mono text-[0.52rem] tracking-[0.2em] uppercase text-grey-dark flex-wrap","children":[["$","li",null,{"children":["$","$L3",null,{"href":"/","className":"hover:text-orange-DEFAULT transition-colors","children":"Home"}]}],["$","li",null,{"children":"/"}],["$","li",null,{"children":["$","$L3",null,{"href":"/blog","className":"hover:text-orange-DEFAULT transition-colors","children":"Blog"}]}],["$","li",null,{"children":"/"}],["$","li",null,{"className":"text-orange-DEFAULT truncate max-w-xs","aria-current":"page","children":"Guides"}]]}]}],["$","d