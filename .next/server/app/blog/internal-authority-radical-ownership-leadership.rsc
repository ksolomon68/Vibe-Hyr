eline gap-2","children":[["$","span",null,{"className":"font-mono text-[0.5rem] text-orange-DEFAULT/80","children":["02","."]}],["$","span",null,{"children":"The Law of the Container: You Get What You Tolerate"}]]}]}],["$","li","the-radical-ownership-script",{"children":["$","a",null,{"href":"#the-radical-ownership-script","className":"font-body text-sm text-grey-DEFAULT hover:text-orange-DEFAULT transition-colors flex items-baseline gap-2","children":[["$","span",null,{"className":"font-mono text-[0.5rem] text-orange-DEFAULT/80","children":["03","."]}],["$","span",null,{"children":"The Radical Ownership Script"}]]}]}],["$","li","from-heroic-soloist-to-multiplier-the-4-stage-apprenticeship-loop",{"children":["$","a",null,{"href":"#from-heroic-soloist-to-multiplier-the-4-stage-apprenticeship-loop","className":"font-body text-sm text-grey-DEFAULT hover:text-orange-DEFAULT transition-colors flex items-baseline gap-2","children":[["$","span",null,{"className":"font-mono text-[0.5rem] text-orange-DEFAULT/80","children":["04","."]}],["$","span",null,{"children":"From Heroic Soloist to Multiplier: The 4-Stage Apprenticeship Loop"}]]}]}]]}]]}],[["$","h2","0",{"id":"why-titles-stop-working-when-the-pressure-rises","className":"scroll-mt-24 font-display text-2xl md:text-3xl tracking-[0.03em] text-white mt-12 mb-4","children":"Why Titles Stop Working When the Pressure Rises"}],["$","p","1",{"className":"font-body text-grey-DEFAULT leading-relaxed mb-5 text-[1.05rem]","children":["Anyone can command a room when budgets are expanding and participation is mandatory. The true test of leadership arrives when resources tighten, volunteer or staff fatigue sets in, and you need people to bring discretionary heart to a hard mission."]}],["$","p","2",{"className":"font-body text-grey-DEFAULT leading-relaxed mb-5 text-[1.05rem]","children":["In those moments, ",["$","strong","1",{"className":"text-white font-semibold","children":"positional power"}]," (relying on your title, rank, or org chart) produces bare-minimum compliance. ",["$","strong","3",{"className":"text-white font-semibold","children":"Internal authority"}]," produces genuine commitment."]}],["$","p","3",{"className":"font-body text-grey-DEFAULT leading-relaxed mb-5 text-[1.05rem]","children":["In the Vibe Hyr Leadership curriculum (",["$","em","1",{"className":"text-white/90 italic","children":"Course 01: Internal Authority"}]," through ",["$","em","3",{"className":"text-white/90 italic","children":"Course 04: The Multiplier Effect"}],"), we define internal authority as the alignment between who you assume you are in private and the standard you hold in public."]}],["$","h2","4",{"id":"the-law-of-the-container-you-get-what-you-tolerate","className":"scroll-mt-24 font-display text-2xl md:text-3xl tracking-[0.03em] text-white mt-12 mb-4","children":"The Law of the Container: You Get What You Tolerate"}],["$","p","5",{"className":"font-body text-grey-DEFAULT leading-relaxed mb-5 text-[1.05rem]","children":["When a community, chapter, or organization begins slipping — meetings starting ten minutes late, action items half-finished, gossip replacing direct feedback — the novice leader blames the people in the room."]}],["$","p","6",{"className":"font-body text-grey-DEFAULT leading-relaxed mb-5 text-[1.05rem]","children":["The master architect looks at the container."]}],["$","blockquote","7",{"className":"border-l-2 border-orange-DEFAULT pl-6 my-8 font-body italic text-grey-DEFAULT text-lg leading-relaxed","children":["",["$","em","1",{"className":"text-white/90 italic","children":"\"You do not get the culture you preach. You get the culture you tolerate and embody.\""}],""]}],["$","p","8",{"className":"font-body text-grey-DEFAULT leading-relaxed mb-5 text-[1.05rem]","children":["Every time a leader walks past a missed commitment without addressing it, or starts a meeting twelve minutes late to wait for stragglers, they issue an official decree to the organization's subconscious: ",["$","em","1",{"className":"text-white/90 italic","children":"\"Our stated standards are optional.\""}],""]}],["$","h2","9",{"id":"the-radical-ownership-script","className":"scroll-mt-24 font-display text-2xl md:text-3xl tracking-[0.03em] text-white mt-12 mb-4","children":"The Radical Ownership Script"}],["$","p","10",{"className":"font-body text-grey-DEFAULT leading-relaxed mb-5 text-[1.05rem]","children":["If your team's culture has drifted, do not open your next meeting by scolding them. Scolding triggers ego defense. Instead, disarm every ego in the room within 60 seconds using the ",["$","strong","1",{"className":"text-white font-semibold","children":"Radical Ownership Script"}],":"]}],["$","ul","11",{"className":"flex flex-col gap-3 my-6","children":[["$","li","0",{"className":"flex items-start gap-3 font-body text-grey-DEFAULT","children":[["$","span",null,{"className":"text-orange-DEFAULT mt-1 flex-shrink-0","children":"✦"}],["$","span",null,{"children":["",["$","strong","1",{"className":"text-white font-semibold","children":"Step 1 — Own the Container:"}]," ",["$","em","3",{"className":"text-white/90 italic","children":"\"Where our commitments and execution have slipped over the last quarter, that is a reflection of unclear standards and inconsistent follow-through from me — not a lack of capability from you.\""}],""]}]]}],["$","li","1",{"className":"flex items-start gap-3 font-body text-grey-DEFAULT","children":[["$","span",null,{"className":"text-orange-DEFAULT mt-1 flex-shrink-0","children":"✦"}],["$","span",null,{"children":["",["$","strong","1",{"className":"text-white font-semibold","children":"Step 2 — Declare the Reset:"}]," ",["$","em","3",{"className":"text-white/90 italic","children":"\"Starting today, we are upgrading the container. Every session starts at :00 sharp, ends on time, and closes with single-owner commitments.\""}],""]}]]}],["$","li","2",{"className":"flex items-start gap-3 font-body text-grey-DEFAULT","children":[["$","span",null,{"className":"text-orange-DEFAULT mt-1 flex-shrink-0","children":"✦"}],["$","span",null,{"children":["",["$","strong","1",{"className":"text-white font-semibold","children":"Step 3 — Invite Alignment:"}]," ",["$","em","3",{"className":"text-white/90 italic","children":"\"I am holding myself to this standard first, and I am asking each of you to step into it with me.\""}],""]}]]}]]}],["$","p","12",{"className":"font-body text-grey-DEFAULT leading-relaxed mb-5 text-[1.05rem]","children":["When the leader takes 100% ownership of the standard without blame, excuses lose all oxygen."]}],["$","h2","13",{"id":"from-heroic-soloist-to-multiplier-the-4-stage-apprenticeship-loop","className":"scroll-mt-24 font-display text-2xl md:text-3xl tracking-[0.03em] text-white mt-12 mb-4","children":"From Heroic Soloist to Multiplier: The 4-Stage Apprenticeship Loop"}],["$","p","14",{"className":"font-body text-grey-DEFAULT leading-relaxed mb-5 text-[1.05rem]","children":["The second trap of high-capacity leaders is ",["$","strong","1",{"className":"text-white font-semibold","children":"charismatic hoarding"}]," — becoming the sole sun around which every decision, crisis, and event orbits. When you are the only person who can run the room, you haven't built an organization; you've built a bottleneck."]}],["$","p","15",{"className":"font-body text-grey-DEFAULT leading-relaxed mb-5 text-[1.05rem]","children":["In ",["$","em","1",{"className":"text-white/90 italic","children":"Course 04 (The Multiplier Effect)"}],", we replace solo heroics with the ",["$","strong","3",{"className":"text-white font-semibold","children":"4-Stage Apprenticeship Loop"}],":"]}],["$","ol","16",{"className":"flex flex-col gap-3 my-6","children":[["$","li","0",{"className":"flex items-start gap-3 font-body text-grey-DEFAULT","children":[["$","span",null,{"className":"font-mono text-orange-DEFAULT text-sm flex-shrink-0 mt-0.5","children":["01","."]}],["$","span",null,{"children":["",["$","strong","1",{"className":"text-white font-semibold","children":"Stage 1 — I Do, You Watch:"}]," Bring an emerging leader alongside you and narrate ",["$","em","3",{"className":"text-white/90 italic","children":"why"}]," you make specific decisions in real time."]}]]}],["$","li","1",{"className":"flex items-start gap-3 font-body text-grey-DEFAULT","children":[["$","span",null,{"className":"font-mono text-orange-DEFAULT text-sm flex-shrink-0 mt-0.5","children":["02","."]}],["$","span",null,{"children":["",["$","strong","1",{"className":"text-white font-semibold","children":"Stage 2 — I Do, You Help:"}]," Share ownership of a live meeting or project segment and debrief immediately afterward."]}]]}],["$","li","2",{"className":"flex items-start gap-3 font-body text-grey-DEFAULT","children":[["$","span",null,{"className":"font-mono text-orange-DEFAULT text-sm flex-shrink-0 mt-0.5","children":["03","."]}],["$","span",null,{"children":["",["$","strong","1",{"className":"text-white font-semibold","children":"Stage 3 — You Do, I Help:"}]," Hand them the microphone while you stay in the room as a safety net and coach."]}]]}],["$","li","3",{"className":"flex items-start gap-3 font-body text-grey-DEFAULT","children":[["$","span",null,{"className":"font-mono text-orange-DEFAULT text-sm flex-shrink-0 mt-0.5","children":["04","."]}],["$","span",null,{"children":["",["$","strong","1",{"className":"text-white font-semibold","children":"Stage 4 — You Do, I Applaud:"}]," Step out of the operational loop completely so their authority is unmistakable to the entire community."]}]]}]]}],["$","p","17",{"className":"font-body text-grey-DEFAULT leading-relaxed mb-5 text-[1.05rem]","children":["True leadership is not measured by how many followers need you, but by how many autonomous leaders you multiply."]}]],["$","section",null,{"aria-labelledby":"faq-heading","className":"mt-16 pt-10 border-t border-white/10","children":[["$","div",null,{"className":"flex items-center gap-2 font-mono text-[0.52rem] tracking-[0.25em] uppercase