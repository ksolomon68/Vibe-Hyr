0:["3liVyMVjhg1tkB_fuWghV",[[["",{"children":["blog",{"children":[["slug","thinking-from-vs-thinking-of","d"],{"children":["__PAGE__?{\"slug\":\"thinking-from-vs-thinking-of\"}",{}]}]}]},"$undefined","$undefined",true],["",{"children":["blog",{"children":[["slug","thinking-from-vs-thinking-of","d"],{"children":["__PAGE__",{},[["$L1",[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Article\",\"headline\":\"Thinking From vs. Thinking Of (Neville Goddard's Core Secret Explained)\",\"description\":\"Understand Neville Goddard's distinction between \\\"thinking of\\\" a desire (which reinforces distance and lack) and \\\"thinking from\\\" the fulfilled desire (which reprograms identity).\",\"datePublished\":\"2025-03-04\",\"dateModified\":\"2026-11-17\",\"articleSection\":\"Foundations\",\"keywords\":\"thinking from vs thinking of, living in the end neville goddard, how to think from the end, occupying a state of consciousness, feeling of having vs wanting\",\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://vibehyr.com/blog/thinking-from-vs-thinking-of\"},\"author\":{\"@type\":\"Person\",\"name\":\"Keisha Solomon\",\"jobTitle\":\"Founder & Master Architect, Vibe Hyr\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"Vibe Hyr\",\"url\":\"https://vibehyr.com\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://vibehyr.com/icons/icon-512.png\"}},\"image\":\"https://vibehyr.com/images/og-image.png\"}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://vibehyr.com\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Blog\",\"item\":\"https://vibehyr.com/blog\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Thinking From vs. Thinking Of: The Most Important Distinction in Manifestation\",\"item\":\"https://vibehyr.com/blog/thinking-from-vs-thinking-of\"}]}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"How can I tell if I am \\\"thinking of\\\" or \\\"thinking from\\\" my desire?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Check your somatic state: \\\"thinking of\\\" carries a subtle bodily tension of reaching, longing, or waiting for something in the future. \\\"Thinking from\\\" feels settled, normal, and grounded in relief — as if the event is already an established fact of your life.\"}}]}"}}],["$","$L2",null,{}],["$","main",null,{"className":"pt-[68px] min-h-screen","children":[["$","section",null,{"className":"py-14 px-6 md:px-14 border-b border-white/8 relative","children":[["$","div",null,{"className":"absolute left-0 top-0 bottom-0 w-1 bg-orange-DEFAULT"}],["$","div",null,{"className":"max-w-3xl mx-auto pl-4","children":[["$","nav",null,{"aria-label":"Breadcrumb","className":"mb-8","children":["$","ol",null,{"className":"flex items-center gap-2 font-mono text-[0.52rem] tracking-[0.2em] uppercase text-grey-dark flex-wrap","children":[["$","li",null,{"children":["$","$L3",null,{"href":"/","className":"hover:text-orange-DEFAULT transition-colors","children":"Home"}]}],["$","li",null,{"children":"/"}],["$","li",null,{"children":["$","$L3",null,{"href":"/blog","className":"hover:text-orange-DEFAULT transition-colors","children":"Blog"}]}],["$","li",null,{"children":"/"}],["$","li",null,{"className":"text-orange-DEFAULT truncate max-w-xs","aria-current":"page","children":"Foundations"}]]}]}],["$","div",null,{"className":"flex items-center gap-3 flex-wrap mb-6","children":[["$","span",null,{"className":"font-mono text-[0.55rem] tracking-[0.3em] uppercase text-orange-DEFAULT","children":"Foundations"}],["$","span",null,{"className":"font-mono text-[0.48rem] tracking-[0.18em] uppercase px-2.5 py-0.5 bg-white/[0.04] border border-white/10 text-grey-DEFAULT","children":"Personal Mastery"}],["$","span",null,{"className":"flex items-center gap-1.5 font-mono text-[0.55rem] tracking-[0.1em] text-grey-dark","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":10,"height":10,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-clock","children":[["$","circle","1mglay",{"cx":"12","cy":"12","r":"10"}],["$","polyline","68esgv",{"points":"12 6 12 12 16 14"}],"$undefined"]}]," ",5," min read"]}]]}],["$","h1",null,{"className":"font-display text-[clamp(2.2rem,5vw,4rem)] leading-[0.95] tracking-[0.02em] text-white mb-5","children":"Thinking From vs. Thinking Of: The Most Important Distinction in Manifestation"}],["$","p",null,{"className":"font-body italic text-grey-DEFAULT text-lg leading-relaxed mb-6","children":"Neville Goddard's single most clarifying insight is the difference between thinking of your desire and thinking from it. One reinforces lack. The other creates reality."}],["$","div",null,{"className":"flex items-center justify-between flex-wrap gap-4 pt-5 border-t border-white/10 font-mono text-[0.5rem] tracking-widest text-grey-dark","children":[["$","div",null,{"children":["By ",["$","span",null,{"className":"text-white font-medium","children":"Keisha Solomon"}]," · ","Founder & Master Architect, Vibe Hyr"]}],["$","div",null,{"className":"flex items-center gap-4","children":[["$","span",null,{"children":["Published ",["$","time",null,{"dateTime":"2025-03-04","children":"March 3, 2025"}]]}],["$","span",null,{"className":"text-[#dfbd8b]","children":["Updated ",["$","time",null,{"dateTime":"2026-11-17","children":"November 16, 2026"}]]}]]}]]}]]}]]}],["$","article",null,{"className":"py-12 px-6 md:px-14","children":["$","div",null,{"className":"max-w-3xl mx-auto","children":[["$","nav",null,{"aria-label":"Table of Contents","className":"mb-10 p-6 bg-black-2 border border-orange-DEFAULT/25","children":[["$","div",null,{"className":"flex items-center gap-2 font-mono text-[0.52rem] tracking-[0.22em] uppercase text-orange-DEFAULT mb-3","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":13,"height":13,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-book-open","children":[["$","path","vv98re",{"d":"M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"}],["$","path","1cyq3y",{"d":"M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"}],"$undefined"]}],"In This Guide"]}],["$","ol",null,{"className":"grid sm:grid-cols-2 gap-x-6 gap-y-2","children":[["$","li","the-distinction-that-changes-everything",{"children":["$","a",null,{"href":"#the-distinction-that-changes-everything","className":"font-body text-sm text-grey-DEFAULT hover:text-orange-DEFAULT transition-colors flex items-baseline gap-2","children":[["$","span",null,{"className":"font-mono text-[0.5rem] text-orange-DEFAULT/80","children":["01","."]}],["$","span",null,{"children":"The Distinction That Changes Everything"}]]}]}],["$","li","a-concrete-example",{"children":["$","a",null,{"href":"#a-concrete-example","className":"font-body text-sm text-grey-DEFAULT hover:text-orange-DEFAULT transition-colors flex items-baseline gap-2","children":[["$","span",null,{"className":"font-mono text-[0.5rem] text-orange-DEFAULT/80","children":["02","."]}],["$","span",null,{"children":"A Concrete Example"}]]}]}],["$","li","why-thinking-of-feels-more-natural",{"children":["$","a",null,{"href":"#why-thinking-of-feels-more-natural","className":"font-body text-sm text-grey-DEFAULT hover:text-orange-DEFAULT transition-colors flex items-baseline gap-2","children":[["$","span",null,{"className":"font-mono text-[0.5rem] text-orange-DEFAULT/80","children":["03","."]}],["$","span",null,{"children":"Why \"Thinking Of\" Feels More Natural"}]]}]}],["$","li","the-practical-test",{"children":["$","a",null,{"href":"#the-practical-test","className":"font-body text-sm text-grey-DEFAULT hover:text-orange-DEFAULT transition-colors flex items-baseline gap-2","children":[["$","span",null,{"className":"font-mono text-[0.5rem] text-orange-DEFAULT/80","children":["04","."]}],["$","span",null,{"children":"The Practical Test"}]]}]}]]}]]}],[["$","h2","0",{"id":"the-distinction-that-changes-everything","className":"scroll-mt-24 font-display text-2xl md:text-3xl tracking-[0.03em] text-white mt-12 mb-4","children":"The Distinction That Changes Everything"}],["$","p","1",{"className":"font-body text-grey-DEFAULT leading-relaxed mb-5 text-[1.05rem]","children":["You can spend years \"practicing manifestation\" and remain stuck — if you never grasp this one distinction."]}],["$","p","2",{"className":"font-body text-grey-DEFAULT leading-relaxed mb-5 text-[1.05rem]","children":["",["$","strong","1",{"className":"text-white font-semibold","children":"Thinking of:"}]," You hold your desire in mind as an object in the distance. Something to be acquired. Something you want. Something you don't yet have. This state of consciousness — however positively framed — registers as ",["$","em","3",{"className":"text-white/90 italic","children":"lack"}]," in the subconscious."]}],["$","p","3",{"className":"font-body text-grey-DEFAULT leading-relaxed mb-5 text-[1.05rem]","children":["",["$","strong","1",{"className":"text-white font-semibold","children":"Thinking from:"}]," You inhabit the state of the person who already has the desire. You don't look at it. You look ",["$","em","3",{"className":"text-white/90 italic","children":"from"}]," it. You see the world through the eyes of the person who is already living the fulfilled wish."]}],["$","blockquote","4",{"className":"border-l-2 border-orange-DEFAULT pl-6 my-8 font-body italic text-grey-DEFAULT text-lg leading-relaxed","children":["",["$","em","1",{"className":"text-white/90 italic","children":"\"To 'think from' your desire is to think from the end. To 'think of' it is to think about it as though it were outside of you.\""}]," — Neville Goddard"]}],["$","h2","5",{"id":"a-concrete-example","className":"scroll-mt-24 font-display text-2xl md:text-3xl tracking-[0.03em] text-white mt-12 mb-4","children":"A Concrete Example"}],["$","p","6",{"className":"font-body text-grey-DEFAULT leading-relaxed mb-5 text-[1.05rem]","children":["You want a loving relationship."]}],["$","p","7",{"className":"font-body text-grey-DEFAULT leading-relaxed mb-5 text-[1.05rem]","children":["",["$","strong","1",{"className":"text-white font-semibold","children":"Thinking of:"}]," ",["$","em","3",{"className":"text-white/90 italic","children":"\"I want a loving relationship. I hope it comes soon. I wonder what they'll be like.\""}]," — This places the relationship firmly in the future, outside of you, unattained."]}],["$","p","8",{"className":"font-body text-grey-DEFAULT leading-relaxed mb-5 text-[1.05rem]","children":["",["$","strong","1",{"className":"text-white font-semibold","children":"Thinking from:"}]," You close your eyes and inhabit the feeling of someone who is deeply loved and deeply loving. You feel the warmth of that connection in your body. You feel the ease, the security, the joy. You see the world from inside that reality. — This places the relationship in your present state of consciousness."]}],["$","p","9",{"className":"font-body text-grey-DEFAULT leading-relaxed mb-5 text-[1.05rem]","children":["The subconscious responds to the state, not the statement."]}],["$","h2","10",{"id":"why-thinking-of-feels-more-natural","className":"scroll-mt-24 font-display text-2xl md:text-3xl tracking-[0.03em] text-white mt-12 mb-4","children":"Why \"Thinking Of\" Feels More Natural"}],["$","p","11",{"className":"font-body text-grey-DEFAULT leading-relaxed mb-5 text-[1.05rem]","children":["The ego is comfortable with desire. It knows how to want things. Wanting keeps it in control — always chasing, always striving."]}],["$","p","12",{"className":"font-body text-grey-DEFAULT leading-relaxed mb-5 text-[1.05rem]","children":["\"Thinking from\" requires a kind of surrender. You have to give up the chase and step into the state of having arrived. This feels unfamiliar. Sometimes even frightening. Because if you've already arrived, what is the ego supposed to do?"]}],["$","p","13",{"className":"font-body text-grey-DEFAULT leading-relaxed mb-5 text-[1.05rem]","children":["This is precisely why the practice is transformative. It requires you to become — in consciousness — what you wish to experience."]}],["$","h2","14",{"id":"the-practical-test","className":"scroll-mt-24 font-display text-2xl md:text-3xl tracking-[0.03em] text-white mt-12 mb-4","children":"The Practical Test"}],["$","p","15",{"className":"font-body text-grey-DEFAULT leading-relaxed mb-5 text-[1.05rem]","children":["A simple test: in your current practice, are you generating the feeling of ",["$","em","1",{"className":"text-white/90 italic","children":"wanting"}]," or the feeling of ",["$","em","3",{"className":"text-white/90 italic","children":"having"}],"?"]}],["$","p","16",{"className":"font-body text-grey-DEFAULT leading-relaxed mb-5 text-[1.05rem]","children":["Wanting has a slight tension to it. A reaching quality. A sense of incompleteness."]}],["$","p","17",{"className":"font-body text-grey-DEFAULT leading-relaxed mb-5 text-[1.05rem]","children":["Having is settled. Satisfied. Grateful for something already present."]}],["$","p","18",{"className":"font-body text-grey-DEFAULT leading-relaxed mb-5 text-[1.05rem]","children":["If you feel tension, you are thinking of. If you feel peace, you are thinking from."]}],["$","p","19",{"className":"font-body text-grey-DEFAULT leading-relaxed mb-5 text-[1.05rem]","children":["Move toward peace."]}]],["$","section",null,{"aria-labelledby":"faq-heading","className":"mt-16 pt-10 border-t border-white/10","children":[["$","div",null,{"className":"flex items-center gap-2 font-mono text-[0.52rem] tracking-[0.25em] uppercase text-orange-DEFAULT mb-2","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":13,"height":13,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle-help","children":[["$","circle","1mglay",{"cx":"12","cy":"12","r":"10"}],["$","path","1u773s",{"d":"M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"}],["$","path","p32p05",{"d":"M12 17h.01"}],"$undefined"]}],"Key Questions Answered"]}],["$","h2",null,{"id":"faq-heading","className":"font-display text-2xl md:text-3xl tracking-[0.03em] text-white mb-6","children":"FREQUENTLY ASKED QUESTIONS"}],["$","div",null,{"className":"space-y-4","children":[["$","div","0",{"className":"bg-black-2 border border-white/10 p-6 hover:border-orange-DEFAULT/30 transition-colors","children":[["$","h3",null,{"className":"font-body font-semibold text-white text-base mb-2","children":"How can I tell if I am \"thinking of\" or \"thinking from\" my desire?"}],["$","p",null,{"className":"font-body text-grey-DEFAULT text-sm leading-relaxed","children":"Check your somatic state: \"thinking of\" carries a subtle bodily tension of reaching, longing, or waiting for something in the future. \"Thinking from\" feels settled, normal, and grounded in relief — as if the event is already an established fact of your life."}]]}]]}]]}],["$","div",null,{"className":"mt-12 pt-6 border-t border-white/8 flex items-center gap-2 flex-wrap","children":[["$","span",null,{"className":"font-mono text-[0.48rem] tracking-[0.2em] uppercase text-grey-dark mr-2","children":"Topics:"}],[["$","span","thinking from vs thinking of",{"className":"font-mono text-[0.46rem] tracking-[0.14em] uppercase px-2.5 py-1 bg-black-2 border border-white/10 text-grey-DEFAULT","children":"thinking from vs thinking of"}],["$","span","living in the end neville goddard",{"className":"font-mono text-[0.46rem] tracking-[